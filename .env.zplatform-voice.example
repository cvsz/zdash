# zDash -> z-platform local realtime voice integration
# Copy these values into the zDash backend environment. Never expose the service
# token through VITE_* variables or frontend build arguments.

ZPLATFORM_VOICE_ENABLED=false
ZPLATFORM_VOICE_GATEWAY_URL=http://127.0.0.1:8450
ZPLATFORM_VOICE_SERVICE_TOKEN=
ZPLATFORM_VOICE_MODEL=qwen3:8b
ZPLATFORM_VOICE_REQUEST_TIMEOUT_SECONDS=5

# The service token must match Z_PLATFORM_SERVICE_TOKEN used by the
# z-platform voice-gateway deployment.
#
# The browser WebSocket URL is controlled by VOICE_PUBLIC_WS_URL on z-platform,
# not by zDash. Examples:
#   local:      ws://127.0.0.1:8450/v1/realtime
#   production: wss://voice.zeaz.dev/v1/realtime
