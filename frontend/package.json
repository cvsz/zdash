{
  "name": "zdash-frontend",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:demo": "node scripts/prepare-public-demo.mjs && tsc -p tsconfig.build.json && vite build --mode public-demo",
    "preview": "vite preview",
    "test": "vitest --run --passWithNoTests",
    "lint": "eslint src --max-warnings=0",
    "build:demo-root": "node scripts/prepare-public-demo.mjs && tsc -p tsconfig.build.json && vite build --mode public-demo --base /"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
