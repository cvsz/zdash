# Compile-time flags for the separate read-only GitHub Pages artifact.
# No API key, browser credential, backend URL, or production identity belongs here.
VITE_PUBLIC_DEMO=true
VITE_APP_ENV=demo
VITE_AUTH_ENABLED=false
VITE_ENABLE_MOCK_FALLBACK=true
VITE_REALTIME_ENABLED=false
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_SHOW_SAFETY_BANNERS=true
